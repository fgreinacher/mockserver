{
    "version": "${VERSION}",
    "description": "MockServer — mock, proxy & record HTTP(S), gRPC, and more (self-contained, bundles its own Java runtime)",
    "homepage": "https://www.mock-server.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mock-server/mockserver-monorepo/releases/download/mockserver-${VERSION}/mockserver-${VERSION}-windows-x86_64.zip",
            "hash": "${SHA256_WINDOWS_X86_64}",
            "extract_dir": "mockserver-${VERSION}-windows-x86_64"
        }
    },
    "bin": [
        [
            "bin\\mockserver.bat",
            "mockserver"
        ]
    ],
    "checkver": {
        "github": "https://github.com/mock-server/mockserver-monorepo",
        "regex": "mockserver-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mock-server/mockserver-monorepo/releases/download/mockserver-$version/mockserver-$version-windows-x86_64.zip",
                "extract_dir": "mockserver-$version-windows-x86_64"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
