      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * sum(rate(mock_server_load_errors_total{job=~\"$job\", scenario=~\"$scenario\"}[1m])) / clamp_min(sum(rate(mock_server_load_requests_total{job=~\"$job\", scenario=~\"$scenario\"}[1m])), 1)" } ]
