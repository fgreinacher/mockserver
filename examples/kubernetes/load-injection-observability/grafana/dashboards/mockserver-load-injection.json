      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "1000 * histogram_quantile(0.95, sum(rate(mock_server_load_request_duration_seconds_bucket{job=~\"$job\", scenario=~\"$scenario\"}[1m])) by (le))" } ]
