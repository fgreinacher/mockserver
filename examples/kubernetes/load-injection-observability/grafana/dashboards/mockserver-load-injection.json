  "tags": ["mockserver", "load-injection", "observability"],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Metrics source",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "description": "Which scrape path to read the load metrics from: the native Prometheus endpoint (mockserver) or the OpenTelemetry re-export (mockserver-otlp). Both carry the identical series — switching proves the OTLP channel matches. Keep it single-valued to avoid double-counting.",
        "definition": "label_values(mock_server_load_requests_total, job)",
        "query": { "query": "label_values(mock_server_load_requests_total, job)", "refId": "StandardVariableQuery" },
        "includeAll": false,
        "multi": false,
        "current": { "text": "mockserver", "value": "mockserver" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "scenario",
        "label": "Scenario",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(mock_server_load_requests_total{job=~\"$job\"}, scenario)",
        "query": { "query": "label_values(mock_server_load_requests_total{job=~\"$job\"}, scenario)", "refId": "StandardVariableQuery" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "MockServer — Load Injection & Observability",
