        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "1000 * histogram_quantile(0.99, sum(rate(mock_server_load_request_duration_seconds_bucket{job=~\"$job\", scenario=~\"$scenario\"}[1m])) by (le))", "legendFormat": "p99" }
